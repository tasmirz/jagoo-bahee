{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "proto/**", "eslint.config.mjs"],
  "tasks": {
    "codegen": {
      "inputs": ["../proto/**"],
      "outputs": ["src/gen/**"],
      "cache": true
    },
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "codegen"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["codegen"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      // Both dev servers consume the sdk's BUILT output — Nest requires dist/cjs and Metro
      // bundles dist/esm — so a cold `pnpm dev:frontend` must not race an unbuilt sdk.
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
