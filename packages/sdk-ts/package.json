{
  "name": "@jagoo/sdk",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Canonical encoding, content IDs, crypto primitives and the signer boundary. Shared by backend/ and frontend/.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./crypto": "./src/crypto/index.ts",
    "./signer": "./src/signer/index.ts",
    "./gen": "./src/gen/index.ts"
  },
  "scripts": {
    "codegen": "node ../../tools/codegen/generate.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist src/gen"
  },
  "dependencies": {
    "@noble/ciphers": "^1.2.1",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@noble/post-quantum": "^0.3.0",
    "@scure/bip32": "^1.6.2",
    "@scure/bip39": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
