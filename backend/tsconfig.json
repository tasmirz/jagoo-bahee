{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // `CommonJS`/`Node` resolver is used with explicit `paths` to work around TS1479 
    // when importing a dual-published workspace package. `node16` resolution incorrectly
    // flags the CJS output as ESM because it ignores the nested package.json for exports.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "paths": {
      "@jagoo/sdk": ["../packages/sdk-ts/dist/cjs/index"],
      "@jagoo/sdk/proto": ["../packages/sdk-ts/dist/cjs/gen/index.jagoo.v1"],
      "@jagoo/sdk/*": ["../packages/sdk-ts/dist/cjs/*/index"]
    },
    "target": "ES2022",
    "lib": ["ES2022"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
