# Copy to `backend/.env` (gitignored) for a durable local node, then restart the backend.
#
# WITHOUT this file the node boots on in-memory adapters. It reports `ready`, serves every
# route, and loses every community, post and Merkle head on restart while `pnpm ops:up`'s
# Mongo sits empty. Check which one you got:
#
#   curl http://127.0.0.1:3000/health/ready
#   -> {"checks":{"database":"mongo", ...}}       durable
#   -> {"checks":{"database":"in-memory", ...}}   heap; data dies with the process
#
# Real environment variables always win over this file, so Docker Compose, CI and the
# two-node federation harness are unaffected by a developer's `.env`.

# ── Storage ──────────────────────────────────────────────────────────────────────────
# `directConnection=true` is REQUIRED from the host and is not a style choice. `mongo-init`
# initiates rs0 with member host `mongo:27017`, which only resolves inside the compose
# network. With `?replicaSet=rs0` the driver discards this seed in favour of that
# advertised name, fails to resolve it, and server selection hangs with no error at all
# (ops/docker-compose.yml, build log L-16). Transactions still work — the server is a
# replica-set member regardless of how the client connected.
MONGO_URL=mongodb://127.0.0.1:27017/jagoo?directConnection=true
REDIS_URL=redis://127.0.0.1:6379/0

# Blobs. Omit both for the in-memory blob store; attachments then vanish on restart even
# though envelopes persist.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=jagoo
S3_ACCESS_KEY=jagoo
S3_SECRET_KEY=jagoo-dev-only

# ── Secrets ──────────────────────────────────────────────────────────────────────────
# Setting MONGO_URL makes NODE_SIGNING_SEED mandatory — a durable node whose identity is
# regenerated each boot would sign a Merkle log it can no longer be shown to have signed.
# The node refuses to start without it (composition/app.module.ts).
#
# AUTH_*_SECRET are optional outside production, but unset means a fresh random HMAC key
# per boot, so every session is invalidated on restart — which looks exactly like data
# loss from the client. Pin them.
#
# Generate real values, never reuse the placeholders below:
#   pnpm --filter @jagoo/backend secrets:generate
NODE_SIGNING_SEED=REPLACE_ME_base64_32_bytes
POW_SECRET=REPLACE_ME_base64_32_bytes
AUTH_ACCESS_SECRET=REPLACE_ME_base64_32_bytes
AUTH_REFRESH_SECRET=REPLACE_ME_base64_32_bytes

# ── Optional ─────────────────────────────────────────────────────────────────────────
PORT=3000
# MONGO_DB=jagoo            # defaults to the database named in MONGO_URL
# CORS_ORIGINS=http://localhost:8081
# Federation is off unless configured (AR-12); a node with no listen address is
# outbound-only, which is a supported mode and not a degraded one (FD-12).
# FEDERATION_GRPC_LISTEN=0.0.0.0:8444
# FEDERATION_PEERS=<base64key>@LAN=grpc://host:8444
