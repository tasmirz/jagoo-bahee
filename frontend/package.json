{
  "name": "@jagoo/frontend",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Production Expo Router client with domain features, offline data, local signing, and a shared design system.",
  "scripts": {
    "dev": "expo start --dev-client",
    "build": "expo export --platform ios --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "clean": "rimraf dist .expo",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "10.0.0",
