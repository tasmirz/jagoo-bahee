# Optional development default. When omitted, the app asks for a home server on first run
# and stores the selected local_ip:port on the device.
# Android emulator: http://10.0.2.2:3000
# Physical phone: use the computer's LAN address, for example http://192.168.1.20:3000
# EXPO_PUBLIC_NODE_URL=http://10.0.2.2:3000

# Optional Tor home server. The app lists this alongside direct development servers.
# EXPO_PUBLIC_TOR_NODE_URL=http://exampleexampleexampleexampleexampleexampleexampleexample.onion
# EXPO_PUBLIC_NODE_TRANSPORT=tor
